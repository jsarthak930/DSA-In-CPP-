#include <iostream>
#include <vector>
#include <climits>
using namespace std;

const int INF = INT_MAX;

void primMST(const vector<vector<int>>& graph, int n) {
    vector<int> key(n, INF);
    vector<int> parent(n, -1);
    vector<bool> inMST(n, false);

    key[0] = 0;
    int totalCost = 0;
    int edgesSelected = 0;

    cout << "\nMinimum Spanning Tree (MST)\n";
    cout << "----------------------------------\n";
    cout << "Selected Edge\tInstallation Cost\n";

    for (int count = 0; count < n; count++) {
        int u = -1;
        int minKey = INF;

        // Select the unvisited vertex with minimum key
        for (int v = 0; v < n; v++) {
            if (!inMST[v] && key[v] < minKey) {
                minKey = key[v];
                u = v;
            }
        }

        // Check whether all sites are connected
        if (u == -1) {
            break;
        }

        inMST[u] = true;

        if (parent[u] != -1) {
            cout << "Site " << parent[u] + 1
                 << " - Site " << u + 1
                 << "\t" << graph[parent[u]][u] << '\n';

            totalCost += graph[parent[u]][u];
            edgesSelected++;
        }

        // Update costs of adjacent unvisited vertices
        for (int v = 0; v < n; v++) {
            if (!inMST[v] &&
                graph[u][v] != 0 &&
                graph[u][v] < key[v]) {
                key[v] = graph[u][v];
                parent[v] = u;
            }
        }
    }

    cout << "----------------------------------\n";

    if (edgesSelected == n - 1) {
        cout << "Minimum Total Network Cost: "
             << totalCost << '\n';
    } else {
        cout << "Error: Not all mining sites can be connected.\n";
    }
}

int main() {
    int n, e;

    cout << "MINING NETWORK OPTIMIZATION\n";
    cout << "Enter number of mining sites: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of mining sites.\n";
        return 1;
    }

    cout << "Enter number of candidate connections: ";
    cin >> e;

    if (e < 0) {
        cout << "Invalid number of connections.\n";
        return 1;
    }

    vector<vector<int>> graph(n, vector<int>(n, 0));

    cout << "\nEnter connections as: site1 site2 cost\n";
    cout << "Site numbers range from 1 to " << n << ".\n";

    for (int i = 0; i < e; i++) {
        int u, v, w;
        cin >> u >> v >> w;

        if (u < 1 || u > n || v < 1 || v > n ||
            u == v || w <= 0) {
            cout << "Invalid connection. Try again.\n";
            i--;
            continue;
        }

        // Store the minimum cost for duplicate connections
        if (graph[u - 1][v - 1] == 0 ||
            w < graph[u - 1][v - 1]) {
            graph[u - 1][v - 1] = w;
            graph[v - 1][u - 1] = w;
        }
    }

    primMST(graph, n);

    return 0;
}


